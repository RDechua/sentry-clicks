# Copy this file to .env (which is gitignored) and customize for your setup.

# Path to the external Kaggle TalkingData directory.
# Mounted READ-ONLY at /data inside the container.
# If unset, compose falls back to the empty repo ./data directory
# (handy for first-build smoke tests before data is downloaded).
DATA_DIR=/Users/rubenodehcua/data/talkingdata
